          }
        },
        {
          "action": "homeassistant.update_entity",
          "target": {
            "entity_id": "{{ hvac_entity }}"
          }
        },
        {
          "delay": {
            "seconds": 5
          }
        },
        {
          "variables": {
            "hvac_running": "{{ state_attr(hvac_entity, 'hvac_action') not in ['idle', none, 'off'] }}",
            "scheduled": "{{ is_state(scheduled_on_sensor, 'on') }}",
            "occupied": "{{ is_state(occupancy_sensor, 'on') }}",
            "presence": "{{ expand(presence_sensors) | selectattr('state', 'eq', 'on') | list | count > 0 }}",
            "night_owl_enabled": "{{ is_state(night_owl_switch, 'on') }}",
            "device_id": "{{ state_attr(night_owl_switch, 'device_id') }}"
          }
        },
        {
          "variables": {
            "want_schedule": "{{ hvac_running and scheduled and occupied }}",
            "want_night_owl": "{{ hvac_running and (not scheduled) and presence and night_owl_enabled }}"
          }
        },
        {
          "choose": [
            {
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ want_schedule }}"
                }
              ],
              "sequence": [
                {
                  "action": "switch.turn_on",
                  "target": {
                    "entity_id": "{{ schedule_active_switch }}"
                  }
                },
                {
                  "action": "aroma_link_integration.set_night_owl_active",
                  "data": {
                    "device_id": "{{ device_id }}",
                    "enabled": false
                  }
                }
              ]
            },
            {
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ want_night_owl }}"
                }
              ],
              "sequence": [
                {
                  "action": "aroma_link_integration.set_night_owl_active",
                  "data": {
                    "device_id": "{{ device_id }}",
                    "enabled": true
                  }
                },
                {
                  "action": "switch.turn_off",
                  "target": {
                    "entity_id": "{{ schedule_active_switch }}"
                  }
                }
              ]
            }
          ],
          "default": [
            {
              "action": "switch.turn_off",
              "target": {
                "entity_id": "{{ schedule_active_switch }}"
              }
            },
            {
              "action": "aroma_link_integration.set_night_owl_active",
              "data": {
                "device_id": "{{ device_id }}",
                "enabled": false
              }
            }
